get_filename_component(CHIPSTAR_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

set(CHIPSTAR_CUDA_VERSION "12.5.40" CACHE STRING "The CUDA release chipStar presents itself as")

set(CMAKE_CUDA_COMPILER "${CHIPSTAR_PREFIX}/bin/cucc" CACHE FILEPATH "chipStar CUDA compiler driver")
set(CMAKE_CUDA_COMPILER_ID "NVIDIA" CACHE STRING "CUDA compiler vendor id")
set(CMAKE_CUDA_COMPILER_TOOLKIT_VERSION "${CHIPSTAR_CUDA_VERSION}" CACHE STRING "CUDA toolkit version")
set(CMAKE_CUDA_HOST_LINK_LAUNCHER "c++" CACHE FILEPATH "Host linker for CUDA targets")

set(CMAKE_CUDA_STANDARD_COMPUTED_DEFAULT 17)
set(CMAKE_CUDA_EXTENSIONS_COMPUTED_DEFAULT ON)

if(NOT CMAKE_CUDA_ARCHITECTURES)
  set(CMAKE_CUDA_ARCHITECTURES 80 CACHE STRING "CUDA architectures")
endif()

set(CMAKE_CUDA_COMPILER_TOOLKIT_ROOT "${CHIPSTAR_PREFIX}" CACHE PATH "chipStar CUDA toolkit root")
set(CMAKE_CUDA_COMPILER_LIBRARY_ROOT "${CHIPSTAR_PREFIX}" CACHE PATH "chipStar CUDA library root")
set(CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES "${CHIPSTAR_PREFIX}/include/cuspv;${CHIPSTAR_PREFIX}/include" CACHE STRING "chipStar CUDA headers")
set(CMAKE_CUDA_HOST_IMPLICIT_LINK_DIRECTORIES "${CHIPSTAR_PREFIX}/lib" CACHE STRING "chipStar CUDA library directories")
